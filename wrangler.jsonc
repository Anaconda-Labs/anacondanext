{
  // Cloudflare config for anacondanext.com — static site built by Astro.
  // `wrangler deploy` and `wrangler dev` run the build below first, then
  // serve ./dist.
  "name": "anacondanext",
  "compatibility_date": "2026-09-18",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Custom domains activate once anacondanext.com is added as a zone in the
  // Cloudflare dashboard (nameservers at Spaceship updated to Cloudflare's).
  // Then uncomment and `wrangler deploy` again:
  // "routes": [
  //   { "pattern": "anacondanext.com", "custom_domain": true },
  //   { "pattern": "www.anacondanext.com", "custom_domain": true }
  // ]
}
